# Copy to .env.local and fill in (never commit real values).
# Neon project "morgen-mach-ich" (Frankfurt) — use the `dev` branch locally.

# Pooled connection string (host ends in -pooler): used by the app.
DATABASE_URL=
# Direct connection string: used by drizzle-kit for migrations only.
DATABASE_URL_UNPOOLED=

# Neon Auth (#306/#309): Auth URL of the branch (https://…), and a random secret of at least
# 32 characters (openssl rand -base64 32). Only /api/auth and requireUser() need them.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Login gate (#446): 1 = the app pages require sign-in (proxy.ts). Leave empty until #314.
AUTH_REQUIRED=

# Learning widget (#462): the n8n Daily Learning Agent behind ngrok. Set all three or none
# (none = the /api/learning routes answer 404). Base URL without a trailing slash, the n8n
# Header Auth key (X-Api-Key) and the Neon Auth user id of the only user who may use it.
LEARNING_API_URL=
LEARNING_API_KEY=
LEARNING_OWNER_ID=
