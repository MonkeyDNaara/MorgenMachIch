# Copy to .env.local and fill in (never commit real values).
# Neon project "morgen-mach-ich" (Frankfurt) — use the `dev` branch locally.

# Pooled connection string (host ends in -pooler): used by the app.
DATABASE_URL=
# Direct connection string: used by drizzle-kit for migrations only.
DATABASE_URL_UNPOOLED=

# Neon Auth (#306/#309): Auth URL of the branch (https://…), and a random secret of at least
# 32 characters (openssl rand -base64 32). Only /api/auth and requireUser() need them.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
